{
  "expo": {
    "name": "Teninde",
    "slug": "teninde",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "teninde",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teninde.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Teninde, size özel içerik ve deneyim sunabilmek için bu izne ihtiyaç duyar. Verileriniz güvende tutulur ve üçüncü taraflarla paylaşılmaz.",
        "NSLocationWhenInUseUsageDescription": "Teninde, bulunduğunuz bölgenin hava durumuna ve mevsime en uygun parfüm önerilerini sunabilmek için konum verinize ihtiyaç duyar.",
        "NSLocationAlwaysUsageDescription": "Teninde, bulunduğunuz bölgenin hava durumuna ve mevsime en uygun parfüm önerilerini sunabilmek için konum verinize ihtiyaç duyar.",
        "GADApplicationIdentifier": "ca-app-pub-1731461024871182~9770094099",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "6N8R46PLF9",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.teninde.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.teninde.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EE",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#121010"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1731461024871182~1620940090",
          "iosAppId": "ca-app-pub-1731461024871182~9770094099"
        }
      ],
      "expo-tracking-transparency",
      "expo-font",
      "expo-web-browser",
      "expo-asset",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "owner": "yusufizzetgenc"
  }
}
